# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real keys.
# Restart `npm run dev` after any change — Next reads this file
# once at startup, and NEXT_PUBLIC_* values are inlined at build.
# ─────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════
# Public site URL — set it in production.
#
# One value for every absolute URL the app writes: canonical
# tags, the sitemap, robots.txt, JSON-LD, the logo and links in
# all five email templates, and the PDF footer. Unset it falls
# back to https://aerolearn.name.ng, which is how it shipped.
#
# Origin only — no trailing slash, no path.
#
# Four places have to agree on this, or things break in ways that
# look unrelated:
#
#   1. Vercel → Settings → Domains (add the domain, follow the
#      DNS records it gives you)
#   2. Supabase → Authentication → URL Configuration → Site URL,
#      plus <origin>/auth/callback on the Redirect allow list.
#      Miss this and sign-in fails with "requested path is
#      invalid".
#   3. Google Cloud Console → Google Auth Platform → Branding →
#      Authorized domains. Must be the registrable domain, and
#      it has to be verified in Search Console first.
#   4. Resend → Domains, verified by DNS — see RESEND_MAIL_DOMAIN
#      below.
#
# NEXT_PUBLIC_* is inlined at build time, so changing this needs
# a redeploy, not just a restart of the server.
# ═════════════════════════════════════════════════════════════
NEXT_PUBLIC_SITE_URL=https://aerolearn.name.ng


# ═════════════════════════════════════════════════════════════
# Supabase — REQUIRED. Nothing works without these three.
#
# Dashboard → Project Settings → API.
# Full walkthrough, including the schema and Auth redirect URLs:
# see SUPABASE_SETUP.md.
# ═════════════════════════════════════════════════════════════

# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# "anon public" key. Ships to the browser — safe, because every
# query still passes through row-level security as the signed-in
# user.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# "service_role secret" key. Bypasses row-level security
# COMPLETELY. Server-side route handlers only.
#
# Never prefix this with NEXT_PUBLIC_. Never import
# lib/supabase/admin.ts from a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ═════════════════════════════════════════════════════════════
# Aether AI gateway — REQUIRED for AI features.
#
# The tutor, quiz generator, flashcards, essay grader and
# timetable builder all route through app/api/ai-*. Server-side
# only; the key never reaches the browser.
#
# Create a key at https://obasi-ai.vercel.app/dashboard/api-keys.
# ═════════════════════════════════════════════════════════════
AETHER_API_KEY=aether_live_your_key
# Chat model used for tutor, quiz, flashcards and question review.
AETHER_MODEL=aether-minimax-m3-1-flash
# Optional second gateway model for independent lesson review; defaults to AETHER_MODEL.
# AETHER_REVIEW_MODEL=your-review-model
# Optional: enables in-app YouTube video suggestions in the lesson editor.
# YOUTUBE_API_KEY=your-youtube-data-api-key
# Set a vision-capable model for image messages and essay grading.
# AETHER_VISION_MODEL=your-vision-model
# Required for voice notes; choose a transcription model listed by Aether.
# AETHER_TRANSCRIPTION_MODEL=your-transcription-model


# ═════════════════════════════════════════════════════════════
# Resend — REQUIRED for transactional email.
#
# Verification, password reset, the onboarding welcome, the
# contact form and the daily drip. Without it those routes
# return 503 rather than failing silently.
#
# The key alone is not enough: Resend refuses to send from a
# domain it has not verified, so add the domain under
# Resend → Domains and publish the DKIM and SPF records it
# prints. Until that is green, every send fails with a 403 and
# nobody can confirm an account or reset a password.
#
# https://resend.com/api-keys
# ═════════════════════════════════════════════════════════════
RESEND_API_KEY=re_your-resend-key

# The domain in the From: address — welcome@, support@, hello@
# and contact@. Defaults to the host in NEXT_PUBLIC_SITE_URL,
# which is right whenever mail and site share a domain.
#
# Set it on preview deployments: those run on *.vercel.app, and
# a sender there is a domain Resend has never verified.
# RESEND_MAIL_DOMAIN=aerolearn.name.ng


# ═════════════════════════════════════════════════════════════
# Cloudinary — OPTIONAL. Unsigned uploads for lesson images.
#
# Only the cloud name is read, and only client-side, so no API
# secret is needed. Set up an unsigned upload preset in the
# Cloudinary console.
# ═════════════════════════════════════════════════════════════
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name


# ═════════════════════════════════════════════════════════════
# Cron secret — REQUIRED in production.
#
# Guards the two scheduled routes in vercel.json:
#   /api/email-drip        daily  09:00
#   /api/challenges/generate  Mondays 00:00
#
# Vercel sends it as `Authorization: Bearer $CRON_SECRET`.
# Unset, those routes are reachable by anyone who knows the
# path — so set it before deploying.
#
# Generate one:  openssl rand -hex 32
# ═════════════════════════════════════════════════════════════
CRON_SECRET=


# ═════════════════════════════════════════════════════════════
# ALOC past-question API — OPTIONAL, /admin/aloc-sync only.
#
# Proxied server-side by app/api/aloc/route.ts; never sent to
# the browser, never stored. Without it an admin can paste a
# token into the sync form for a single request.
#
# https://questions.aloc.com.ng
# ═════════════════════════════════════════════════════════════
# ALOC_ACCESS_TOKEN=your-aloc-access-token


# ─────────────────────────────────────────────────────────────
# Removed with the Firebase migration — delete these from your
# .env.local if they are still there. Nothing reads them:
#
#   FIREBASE_PROJECT_ID
#   FIREBASE_CLIENT_EMAIL
#   FIREBASE_PRIVATE_KEY
#   FIREBASE_GOOGLE_APPLICATION_CREDENTIALS
#   GOOGLE_AI_API_KEY          (superseded by AETHER_API_KEY)
#   GROQ_API_KEY               (superseded by AETHER_API_KEY)
#   CLOUDINARY_API_KEY         (unsigned uploads need no secret)
#   CLOUDINARY_API_SECRET
# ─────────────────────────────────────────────────────────────
