# AeroLearn Desktop — Supabase connection
#
# Copy this file to `.env.local` in this directory and fill in the two values
# below. The desktop app talks to the same Supabase project as the website, so
# students see the same lessons and can download them for offline study.
#
# Without these, the desktop app still runs in demo mode using seed lessons.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
