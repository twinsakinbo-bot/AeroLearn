{
  "name": "aerolearn",
  "version": "1.0.2",
  "description": "AeroLearn Desktop Application",
  "author": {
    "name": "Aerolearn",
    "email": "support@aerolearn.name.ng"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "psql \"$SUPABASE_TEST_DATABASE_URL\" -v ON_ERROR_STOP=1 -f tests/security-policies.sql",
    "desktop:check": "npm --prefix desktop-app run build",
    "test:plans": "tsx --test tests/plan-flow.test.ts",
    "desktop:dev": "npx tauri dev",
    "desktop:build": "npm --prefix desktop-app run build && npx tauri build"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.58.0",
    "autoprefixer": "10.4.16",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.19.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^13.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.8.0",
    "next": "15.5.29",
    "papaparse": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "postcss": "8.5.33",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-joyride": "^3.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
