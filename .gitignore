# ─────────────────────────────────────────────────────────────
# Secrets — never commit these.
#
# NOTE: these two lines were previously appended from PowerShell,
# which writes UTF-16. The NUL bytes meant git matched neither
# pattern and .env.local was committed. Keep this file UTF-8; use
# an editor or `printf` rather than PowerShell `>>` to append.
# ─────────────────────────────────────────────────────────────
.env
.env.local
.env*.local

# Service-account / credential files
serviceAccountKey.json
*.pem
*.p12

# ─────────────────────────────────────────────────────────────
# Build output
# ─────────────────────────────────────────────────────────────
.next/
out/
dist/
build/Release
*.tsbuildinfo
next-env.d.ts

# Compiled Tailwind. `app/globals.css` is the source; a committed bundle here
# just goes stale and keeps the pre-redesign palette alive in every audit.
app/output.css

# Desktop builds
src-tauri/target/
src-tauri/gen/

# ─────────────────────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────────────────────
node_modules/
.npm
.yarn-integrity
*.tgz
bower_components
.lock-wscript

# ─────────────────────────────────────────────────────────────
# Logs & scratch
# ─────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
errors*.txt
error-output.txt
build-*.log
dev-output.log
tsc-check.log
scratch/

# ─────────────────────────────────────────────────────────────
# Caches
# ─────────────────────────────────────────────────────────────
.eslintcache
.node_repl_history
coverage
.nyc_output
.grunt
lib-cov

# ─────────────────────────────────────────────────────────────
# Tooling / editor
# ─────────────────────────────────────────────────────────────
.vercel
.aider*
.onecode
.DS_Store
Thumbs.db

# Runtime data
pids
*.pid
*.seed
*.pid.lock

.next/
public/downloads/*.exe
