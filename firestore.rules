rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Shared helper: does the authenticated user have admin role?
    // ─────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─────────────────────────────────────────────────────────────
    // users
    //   - Any authenticated user can READ profiles (community/leaderboard).
    //   - Students may only WRITE their own profile.
    //   - Admins may read/write any user.
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      // Users can update their own profile except server-managed protected fields
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                        ['role', 'subscription', 'proExpiresAt']
                    );
      // parentMode and parentInviteCode are user-editable — explicitly allowed above
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!('role' in request.resource.data) || request.resource.data.role != 'admin')
                    && (!('subscription' in request.resource.data) || request.resource.data.subscription == 'free');
      // setDoc with merge=true needs write access too — covered by update above
      allow write: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                        ['role', 'subscription', 'proExpiresAt']
                    );
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // verificationRequests  (receipt uploads → subscription upgrade)
    //   - Authenticated users can CREATE their own request.
    //   - Users can READ their own requests.
    //   - Admins can read/write all.
    // ─────────────────────────────────────────────────────────────
    match /verificationRequests/{requestId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read:   if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // conversations  (direct messages between students)
    //   - Participants can read/update their conversation doc.
    //   - Any authenticated user can create a conversation.
    // ─────────────────────────────────────────────────────────────
    match /conversations/{convId} {
      allow read, update, delete: if request.auth != null
                          && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;

      // messages sub-collection
      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid in
                         get(/databases/$(database)/documents/conversations/$(convId)).data.participants
                      && (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == 'ai-bot');
        allow delete: if request.auth != null
                      && request.auth.uid in
                         get(/databases/$(database)/documents/conversations/$(convId)).data.participants
                      && (resource.data.senderId == request.auth.uid || resource.data.senderId == 'ai-bot');
        allow update: if request.auth != null
                      && request.auth.uid in
                         get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }
    }

    // ─────────────────────────────────────────────────────────────
    // reports  (report a user)
    //   - Any authenticated user can file a report.
    //   - Only admins can read/manage reports.
    // ─────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reportedBy == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // friendRequests
    //   - Users can create a request to someone.
    //   - Users can read, update, or delete requests sent TO them or BY them.
    // ─────────────────────────────────────────────────────────────
    match /friendRequests/{requestId} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow read, update, delete: if request.auth != null && 
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ─────────────────────────────────────────────────────────────
    // contactMessages  (contact form)
    //   - Anyone can submit.
    //   - Only admins can read.
    // ─────────────────────────────────────────────────────────────
    match /contactMessages/{msgId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // practiceQuestions
    //   - Authenticated students can READ.
    //   - Only admins can write.
    // ─────────────────────────────────────────────────────────────
    match /practiceQuestions/{questionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // subjects / topics  (learning content)
    //   - Publicly readable.
    //   - Only admins may write.
    // ─────────────────────────────────────────────────────────────
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // notes  (admin-published lesson notes)
    // ─────────────────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if request.auth != null && resource.data.isPublished == true;
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // userNotes  (student's personal uploaded notes)
    // ─────────────────────────────────────────────────────────────
    match /userNotes/{noteId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, write, delete: if request.auth != null
                                  && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // homework  (admin-published assignments)
    // ─────────────────────────────────────────────────────────────
    match /homework/{homeworkId} {
      allow read: if request.auth != null && resource.data.status == "published";
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // homeworkSubmissions
    // ─────────────────────────────────────────────────────────────
    match /homeworkSubmissions/{submissionId} {
      allow create: if request.auth != null &&
        request.resource.data.studentId == request.auth.uid;
      allow read, update: if request.auth != null &&
        resource.data.studentId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // userProgress
    // ─────────────────────────────────────────────────────────────
    match /userProgress/{progressId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid);
      allow read: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // store / purchases
    // ─────────────────────────────────────────────────────────────
    match /storeItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // parentLinks  (parent <-> student connections)
    //   - A parent can create a link where they are the parentUid.
    //   - A parent can read links where they are the parentUid.
    //   - A parent can delete their own links.
    //   - Admins have full access.
    // ─────────────────────────────────────────────────────────────
    match /parentLinks/{linkId} {
      allow create: if request.auth != null
                    && request.resource.data.parentUid == request.auth.uid;
      allow read, delete: if request.auth != null
                    && resource.data.parentUid == request.auth.uid;
      allow read, write: if isAdmin();
    }
  }
}