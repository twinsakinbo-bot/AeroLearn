rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Receipts: authenticated users can upload their own receipts
    match /receipts/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // max 5MB
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // Profile pictures: authenticated users can upload their own
    match /profile-pictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Homework uploads: authenticated users can upload their own homework
    match /homework/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;  // max 10MB
    }

    // Notes uploads: authenticated users can upload their own notes
    match /notes/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;  // max 10MB
    }

    // Admin-only uploads (question images, lesson assets, etc.)
    match /admin/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Only writable via Admin SDK / Firebase Console
    }
  }
}
